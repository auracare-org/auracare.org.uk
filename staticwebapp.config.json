{
  "routes": [
    {
      "route": "/relay/static/*",
      "rewrite": "https://eu-assets.i.posthog.com/static/*"
    },
    {
      "route": "/relay/array/*",
      "rewrite": "https://eu-assets.i.posthog.com/array/*"
    },
    {
      "route": "/relay/*",
      "rewrite": "https://eu.i.posthog.com/*"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
